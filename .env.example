# ==============================================================================
# Variables de entorno de ejemplo (API Gateway con NestJS)
# Copia este archivo como .env y ajusta los valores si es necesario
# ==============================================================================

# Puerto del API Gateway (punto de entrada para los clientes)
GATEWAY_PORT=3000

# Puerto del microservicio de productos
PRODUCT_SERVICE_PORT=3001

# Puerto del microservicio de usuarios
USERS_SERVICE_PORT=3002

# URL interna del product-service dentro de la red de Docker Compose
# El API Gateway usa esta variable para redirigir las peticiones
PRODUCT_SERVICE_URL=http://product-service:3001

# URL interna del users-service dentro de la red de Docker Compose
USERS_SERVICE_URL=http://users-service:3002

# Rate limiting del API Gateway (máx. peticiones por franja de tiempo, por IP)
THROTTLE_TTL=15000
THROTTLE_LIMIT=30
